5072\f2  \emdash  \f0\lang1049\'d1\'ee\'ee\'e1\'f9\'e0\'e5\'f2\'f1\'ff, \'f7\'f2\'ee \'c0\'ed\'e0\'f1 \'e8\'e1\'ed \'cc\'e0\'eb\'e8\'ea \'f1\'ea\'e0\'e7\'e0\'eb: \f1\lang1033\'ab\f0\lang1049\'ca\'ee\'e3\'e4\'e0 \f2\lquote\f0\'c0\'e1\'e4\'f3\'f0\'f0\'e0\'f5\'ec\'e0\'ed \'e8\'e1\'ed \f2\lquote\f0\'c0\'f3\'f4 \'ef\'f0\'e8\'e1\'fb\'eb (\'e2 \'cc\'e5\'e4\'e8\'ed\'f3), \'cf\'f0\'ee\'f0\'ee\'ea \'ef\'ee\'e1\'f0\'e0\'f2\'e0\'eb \'e5\'e3\'ee \'f1 \'d1\'e0\f2\lquote\f0\'e4\'ee\'ec \'e8\'e1\'ed \'e0\'f0-\'d0\'e0\'e1\'e8\f2\lquote  \f0\'e0\'eb\'fc-\'c0\'ed\'f1\'e0\'f0\'e8, \'ea\'ee\'f2\'ee\'f0\'fb\'e9 \'ef\'f0\'e5\'e4\'eb\'ee\'e6\'e8\'eb \'e5\'ec\'f3 \'ef\'ee\'e4\'e5\'eb\'e8\'f2\'fc \'e4\'e2\'f3\'f5 \'f1\'e2\'ee\'e8\'f5 \'e6\'b8\'ed \'e8 \'e8\'ec\'f3\'f9\'e5\'f1\'f2\'e2\'ee \'ef\'ee\'ef\'ee\'eb\'e0\'ec. \'ce\'e4\'ed\'e0\'ea\'ee \f2\lquote\f0\'c0\'e1\'e4\'f3\'f0\'f0\'e0\'f5\'ec\'e0\'ed \'ee\'f2\'e2\'e5\'f2\'e8\'eb: \f2\ldblquote\f0\'c4\'e0 \'e1\'eb\'e0\'e3\'ee\'f1\'eb\'ee\'e2\'e8\'f2 \'c0\'eb\'eb\'e0\'f5 \'f2\'e2\'ee\'fe \'f1\'e5\'ec\'fc\'fe \'e8 \'f2\'e2\'ee\'b8 \'e8\'ec\'f3\'f9\'e5\'f1\'f2\'e2\'ee! \'cf\'ee\'ea\'e0\'e6\'e8\'f2\'e5 \'ec\'ed\'e5 \'f0\'fb\'ed\'ee\'ea\f2\rdblquote\f0 . \'ce\'ed \'ef\'ee\'f8\'b8\'eb \'ed\'e0 \'f0\'fb\'ed\'ee\'ea \'e8 \'e7\'e0\'f0\'e0\'e1\'ee\'f2\'e0\'eb \'f1\'f3\'f8\'b8\'ed\'fb\'e9 \'f2\'e2\'ee\'f0\'ee\'e3 \'e8 \'ec\'e0\'f1\'eb\'ee. \'d7\'e5\'f0\'e5\'e7 \'ed\'e5\'f1\'ea\'ee\'eb\'fc\'ea\'ee \'e4\'ed\'e5\'e9 \'cf\'f0\'ee\'f0\'ee\'ea\f2  \f0\'f3\'e2\'e8\'e4\'e5\'eb \'ed\'e0 \'ed\'b8\'ec \'e6\'b8\'eb\'f2\'fb\'e5 \'f1\'eb\'e5\'e4\'fb (\'ee\'f2 \'e1\'eb\'e0\'e3\'ee\'e2\'ee\'ed\'e8\'e9 \'ed\'e0 \'f2\'e5\'eb\'e5), \'e8 \'f1\'ef\'f0\'ee\'f1\'e8\'eb: \f2\ldblquote\f0\'d7\'f2\'ee \'fd\'f2\'ee, \'ee \f2\lquote\f0\'c0\'e1\'e4\'f3\'f0\'f0\'e0\'f5\'ec\'e0\'ed?\f2\rdblquote  \f0\'ce\'ed \'ee\'f2\'e2\'e5\'f2\'e8\'eb: \f2\ldblquote\f0\'df \'e6\'e5\'ed\'e8\'eb\'f1\'ff \'ed\'e0 \'e6\'e5\'ed\'f9\'e8\'ed\'e5 \'e8\'e7 \'e0\'ed\'f1\'e0\'f0\'ee\'e2\f2\rdblquote\f0 . \'ce\'