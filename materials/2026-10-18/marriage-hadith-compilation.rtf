ang1033\'bb. \f0\lang1049\'d2\'ee\'f2 \'f1\'ef\'f0\'ee\'f1\'e8\'eb: \f1\lang1033\'ab\f0\lang1049\'ce \'cf\'ee\'f1\'eb\'e0\'ed\'ed\'e8\'ea \'c0\'eb\'eb\'e0\'f5\'e0, \'e0 \'ea\'f2\'ee \'ef\'ee\'ec\'ee\'e6\'e5\'f2 \'ec\'ed\'e5?\f1\lang1033\'bb \f0\lang1049\'cf\'ee\'f1\'eb\'e0\'ed\'ed\'e8\'ea \'c0\'eb\'eb\'e0\'f5\'e0 \'f1\'ea\'e0\'e7\'e0\'eb: \f1\lang1033\'ab\f0\lang1049\'d2\'e5\'e1\'e5 \'ee\'e1\'ff\'e7\'e0\'ed \'ef\'ee\'ec\'ee\'e3\'e0\'f2\'fc \'ea\'e0\'e6\'e4\'fb\'e9 \'e2\'e5\'f0\'f3\'fe\'f9\'e8\'e9 (\'e8\'eb\'e8: \'ea\'e0\'e6\'e4\'fb\'e9 \'ec\'f3\'f1\'f3\'eb\'fc\'ec\'e0\'ed\'e8\'ed)\f1\lang1033\'bb.\f0\lang1049  \'d8\'e5\'e9\'f5 \'e0\'eb\'fc-\'c0\'eb\'e1\'e0\'ed\'e8 \'f1\'ea\'e0\'e7\'e0\'eb: \f1\lang1033\'ab\f0\lang1049\'d5\'ee\'f0\'ee\'f8\'e8\'e9 \'f5\'e0\'e4\'e8\'f1 /\'f5\'e0\'f1\'e0\'ed/\f1\lang1033\'bb.\par
