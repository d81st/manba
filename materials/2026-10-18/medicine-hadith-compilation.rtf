3895 \f1\emdash  \f0\lang1049\'cf\'e5\'f0\'e5\'e4\'e0\'e5\'f2\'f1\'ff \'ee\'f2 \f1\lquote\f0\'c0\'e8\'f8\'e8, \'e4\'e0 \'e1\'f3\'e4\'e5\'f2 \'e4\'ee\'e2\'ee\'eb\'e5\'ed \'e5\'fe \'c0\'eb\'eb\'e0\'f5, \'f7\'f2\'ee, \'ea\'ee\'e3\'e4\'e0 \'f7\'e5\'eb\'ee\'e2\'e5\'ea \'e6\'e0\'eb\'ee\'e2\'e0\'eb\'f1\'ff \'ed\'e0 \'f7\'f2\'ee-\'eb\'e8\'e1\'ee, \'cf\'f0\'ee\'f0\'ee\'ea\f1  \f0\'ea\'e0\'f1\'e0\'eb\'f1\'ff \'e7\'e5\'ec\'eb\'e8 \'ef\'f0\'e5\'e4\'e2\'e0\'f0\'e8\'f2\'e5\'eb\'fc\'ed\'ee \'f1\'ec\'ee\'f7\'e5\'ed\'ed\'fb\'ec \'f1\'eb\'fe\'ed\'ee\'e9 \'f3\'ea\'e0\'e7\'e0\'f2\'e5\'eb\'fc\'ed\'fb\'ec \'ef\'e0\'eb\'fc\'f6\'e5\'ec \'e8 (\'ef\'f0\'ee\'f2\'e8\'f0\'e0\'eb \'e1\'ee\'eb\'fc\'ed\'ee\'e5 \'ec\'e5\'f1\'f2\'ee \'f1\'ee \'f1\'eb\'ee\'e2\'e0\'ec\'e8): \f2\lang1033\'ab\f0\lang1049\'cf\'ee\'f7\'e2\'e0 \'ed\'e0\'f8\'e5\'e9 \'e7\'e5\'ec\'eb\'e8 \f1\emdash  \f0\'e2\'ec\'e5\'f1\'f2\'e5 \'f1\'ee \'f1\'eb\'fe\'ed\'ee\'e9 \'ea\'ee\'e3\'ee-\'ed\'e8\'e1\'f3\'e4\'fc \'e8\'e7 \'ed\'e0\'f1, \'e8 \'e1\'f3\'e4\'e5\'f2 \'e8\'f1\'f6\'e5\'eb\'b8\'ed \'ed\'e0\'f8 \'e1\'ee\'eb\'fc\'ed\'ee\'e9 \'f1 \'e4\'ee\'e7\'e2\'ee\'eb\'e5\'ed\'e8\'ff \'ed\'e0\'f8\'e5\'e3\'ee \'c3\'ee\'f1\'ef\'ee\'e4\'e0! /\'c1\'e8\'f1\'ec\'e8-\'cb\'eb\'ff\'f5\'e8! \'d2\'f3\'f0\'e1\'e0\'f2\'f3 \'e0\'f0\'e4\'fb-\'ed\'e0 \'e1\'e8\'f0\'e8\'ea\'e0\'f2\'e8 \'e1\'e0\f1\lquote\f0\'e4\'fb-\'ed\'e0, \'e9\'f3\'f8\'f4\'e0 \'f1\'e0\'ea\'fb\'ec\'f3-\'ed\'e0 \'e1\'e8-\'e8\'e7\'ed\'e8 \'d0\'e0\'e1\'e1\'e8-\'ed\'e0!/\f2\lang1033\'bb.\f0\lang1049  \f2\lang1033\'ab\f0\lang1049\'c4\'ee\'f1\'f2\'ee\'e2\'e5\'f0\'ed\'fb\'e9 \'f5\'e0\'e4\'e8\'f1 /\'f1\'e0\'f5\'e8\'f5/\f2\lang1033\'bb.\par
