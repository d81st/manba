\f0\fs22\lang1049 1747 - \'cf\'e5\'f0\'e5\'e4\'e0\'ed\'ee \'ee\'f2 \'c0\'e1\'f3 \'d5\'f3\'f0\'e5\'e9\'f0\'fb, \'f7\'f2\'ee \'cf\'ee\'f1\'eb\'e0\'ed\'ed\'e8\'ea \'c0\'eb\'eb\'e0\'f5\'e0 \'f1\'ea\'e0\'e7\'e0\'eb: \f1\lang1033\'ab\f0\lang1049\'ce\'e4\'e8\'ed \'e8\'e7 \'cf\'f0\'ee\'f0\'ee\'ea\'ee\'e2 \'ee\'f2\'ef\'f0\'e0\'e2\'e8\'eb\'f1\'ff \'e2 \'f1\'e2\'ff\'f9\'e5\'ed\'ed\'f3\'fe \'e2\'ee\'e9\'ed\'f3. \'ce\'ed \'f1\'ea\'e0\'e7\'e0\'eb \'f1\'e2\'ee\'e8\'ec \'ef\'ee\'f1\'eb\'e5\'e4\'ee\'e2\'e0\'f2\'e5\'eb\'ff\'ec: "\'cd\'e5 \'ef\'ee\'e9\'e4\'b8\'f2 \'f1\'ee \'ec\'ed\'ee\'e9 \'f2\'ee\'f2, \'ea\'f2\'ee \'e6\'e5\'ed\'e8\'eb\'f1\'ff \'ed\'e0 \'e6\'e5\'ed\'f9\'e8\'ed\'e5 \'e8 \'f5\'ee\'f7\'e5\'f2 \'f1 \'ed\'e5\'e9 \'f1\'ee\'f7\'e5\'f2\'e0\'f2\'fc\'f1\'ff, \'ed\'ee \'e5\'f9\'b8 \'ed\'e5 \'f1\'e4\'e5\'eb\'e0\'eb \'fd\'f2\'ee\'e3\'ee; \'f2\'ee\'f2, \'ea\'f2\'ee \'ef\'ee\'f1\'f2\'f0\'ee\'e8\'eb \'e4\'ee\'ec, \'ed\'ee \'e5\'f9\'b8 \'ed\'e5 \'ef\'ee\'f1\'f2\'e0\'e2\'e8\'eb \'ea\'f0\'fb\'f8\'f3; \'e8 \'f2\'ee\'f2, \'ea\'f2\'ee \'ea\'f3\'ef\'e8\'eb \'ea\'ee\'e7 \'e8 \'e1\'e5\'f0\'e5\'ec\'e5\'ed\'ed\'fb\'f5 \'e2\'e5\'f0\'e1\'eb\'fe\'e4\'e8\'f6 \'e8 \'e6\'e4\'b8\'f2 \'e8\'f5 \'ef\'ee\'f2\'ee\'ec\'f1\'f2\'e2\'e0". \'c7\'e0\'f2\'e5\'ec \'ee\'ed \'e4\'e2\'e8\'ed\'f3\'eb\'f1\'ff \'e2 \'ef\'ee\'f5\'ee\'e4 \'e8 \'ef\'f0\'e8\'e1\'eb\'e8\'e7\'e8\'eb\'f1\'ff \'ea \'f1\'e5\'eb\'e5\'ed\'e8\'fe \'ef\'f0\'e8\'ec\'e5\'f0\'ed\'ee \'e2\'ee \'e2\'f0\'e5\'ec\'ff \'e2\'e5\'f7\'e5\'f0\'ed\'e5\'e9 \'ec\'ee\'eb\'e8\'f2\'e2\'fb. \'ce\'ed \'f1\'ea\'e0\'e7\'e0\'eb \'f1\'ee\'eb\'ed\'f6\'f3: "\'d2\'fb \'ef\'ee\'e4\'f7\'e8\'ed\'e5\'ed\'e0 (\'c0\'eb\'eb\'e0\'f5\'f3), \'e8 \'ff \'f2\'ee\'e6\'e5. \'ce \'c0\'eb\'eb\'e0\'f5, \'e7\'e0\'e4\'e5\'f0\'e6\'e8 \'e5\'b8 \'e4\'eb\'ff \'ec\'e5\'ed\'ff \'ed\'e5\'ed\'e0\'e4\'ee\'eb\'e3\'ee". \'d1\'ee\'eb\'ed\'f6\'e5 \'e1\'fb\'eb\'ee \'e7\'e0\'e4\'e5\'f0\'e6\'e0\'ed\'ee \'e4\'eb\'ff \'ed\'e5\'e3\'ee, \'ef\'ee\'ea\'e0 \'c0\'eb\'eb\'e0\'f5 \'ed\'e5 \'e4\'e0\'f0\'ee\'e2\'e0\'eb \'e5\'ec\'f3 \'ef\'ee\'e1\'e5\'e4\'f3. \'cb\'fe\'e4\'e8 \'f1\'ee\'e1\'f0\'e0\'eb\'e8 \'e2\'ee\'e5\'ed\'ed\'fb\'e5 \'f2\'f0\'ee\'f4\'e5\'e8. \'ce\'e3\'ee\'ed\'fc \'ef\'ee\'e4\'ee\'f8\'b8\'eb \'ea \'f2\'f0\'ee\'f4\'e5\'ff\'ec, \'f7\'f2\'ee\'e1\'fb \'e8\'f5 \'ef\'ee\'e3\'eb\'ee\'f2\'e8\'f2\'fc, \'ed\'ee \'ee\'ed \'ed\'e5 \'ef\'ee\'e3\'eb\'ee\'f9\'e0\'eb \'e8\'f5. \'ce\'ed (\'cf\'f0\'ee\'f0\'ee\'ea) \'f1\'ea\'e0\'e7\'e0\'eb: "\'cd\'e5\'ea\'ee\'f2\'ee\'f0\'fb\'e5 \'e8\'e7 \'e2\'e0\'f1 \'e2\'e8\'ed\'ee\'e2\'ed\'fb \'e2 \'ef\'f0\'e8\'f1\'e2\'ee\'e5\'ed\'e8\'e8 \'f7\'f3\'e6\'ee\'e3\'ee \'e8\'ec\'f3\'f9\'e5\'f1\'f2\'e2\'e0. \'cf\'f3\'f1\'f2\'fc \'ee\'e4\'e8\'ed \'f7\'e5\'eb\'ee\'e2\'e5\'ea \'e8\'e7 \'ea\'e0\'e6\'e4\'ee\'e3\'ee \'ef\'eb\'e5\'ec\'e5\'ed\'e8 \'ef\'f0\'e8\'f1\'ff\'e3\'e0\'e5\'f2 \'ec\'ed\'e5 \'ed\'e0 \'e2\'e5\'f0\'ed\'ee\'f1\'f2\'fc".  \'ce\'ed\'e8 \'f1\'e4\'e5\'eb\'e0\'eb\'e8 \'fd\'f2\'ee, \'ef\'ee\'eb\'ee\'e6\'e8\'e2 \'f1\'e2\'ee\'e8 \'f0\'f3\'ea\'e8 \'e2 \'e5\'e3\'ee. \'d0\'f3\'ea\'e0 \'ee\'e4\'ed\'ee\'e3\'ee \'f7\'e5\'eb\'ee\'e2\'e5\'ea\'e0 \'ef\'f0\'e8\'eb\'e8\'ef\'eb\'e0 \'ea \'e5\'e3\'ee \'f0\'f3\'ea\'e5.  \'cf\'f0\'ee\'f0\'ee\'ea \'f1\'ea\'e0\'e7\'e0\'eb: "\'d2\'e2\'ee\'b8 \'ef\'eb\'e5\'ec\'ff \'e2\'e8\'ed\'ee\'e2\'ed\'ee \'e2 \'ef\'f0\'e8\'f1\'e2\'ee\'e5\'ed\'e8\'e8 \'f7\'f3\'e6\'ee\'e3\'ee \'e8\'ec\'f3\'f9\'e5\'f1\'f2\'e2\'e0. \'cf\'f3\'f1\'f2\'fc \'e2\'f1\'e5 \'f7\'eb\'e5\'ed\'fb \'f2\'e2\'ee\'e5\'e3\'ee \'ef\'eb\'e5\'ec\'e5\'ed\'e8 \'ef\'f0\'e8\'f1\'ff\'e3\'ed\'f3\'f2 \'ec\'ed\'e5 \'ed\'e0 \'e2\'e5\'f0\'ed\'ee\'f1\'f2\'fc \'ef\'ee \'ee\'e4\'ed\'ee\'ec\'f3".  \'ce\'ed\'e8 \'f1\'e4\'e5\'eb\'e0\'eb\'e8 \'fd\'f2\'ee, \'e8 \'f0\'f3\'ea\'e8 \'e4\'e2\'f3\'f5 \'e8\'eb\'e8 \'f2\'f0\'b8\'f5 \'f7\'e5\'eb\'ee\'e2\'e5\'ea \'ef\'f0\'e8\'eb\'e8\'ef\'eb\'e8 \'ea \'e5\'e3\'ee \'f0\'f3\'ea\'e5.  \'ce\'ed \'f1\'ea\'e0\'e7\'e0\'eb: "\ul\'c2\'fb \'ef\'f0\'e8\'f1\'e2\'ee\'e8\'eb\'e8 \'f1\'e5\'e1\'e5 \'f7\'f3\'e6\'ee\'e5\ulnone !"  \'d2\'ee\'e3\'e4\'e0 \'ee\'ed\'e8 \'e2\'fb\'ed\'e5\'f1\'eb\'e8 \'e5\'ec\'f3 \'e7\'ee\'eb\'ee\'f2\'ee, \'ef\'ee \'ee\'e1\'fa\'b8\'ec\'f3 \'f0\'e0\'e2\'ed\'ee\'e5 \'e3\'ee\'eb\'ee\'e2\'e5 \'ea\'ee\'f0\'ee\'e2\'fb.  \'ce\'ed\'e8 \'ef\'ee\'eb\'ee\'e6\'e8\'eb\'e8 \'e5\'e3\'ee \'ea \'f2\'f0\'ee\'f4\'e5\'ff\'ec \'ed\'e0 \'e7\'e5\'ec\'eb\'fe.  \'d2\'ee\'e3\'e4\'e0 \'ee\'e3\'ee\'ed\'fc \'ef\'ee\'e4\'ee\'f8\'b8\'eb \'ea \'f2\'f0\'ee\'f4\'e5\'ff\'ec \'e8 \'ef\'ee\'e3\'eb\'ee\'f2\'e8\'eb \'e8\'f5. \ul\'c2\'ee\'e5\'ed\'ed\'fb\'e5 \'f2\'f0\'ee\'f4\'e5\'e8 \'ed\'e5 \'e1\'fb\'eb\'e8 \'e4\'ee\'e7\'e2\'ee\'eb\'e5\'ed\'fb \'ed\'e8 \'ee\'e4\'ed\'ee\'ec\'f3 \'ed\'e0\'f0\'ee\'e4\'f3 \'e4\'ee \'ed\'e0\'f1.  \'dd\'f2\'ee \'ef\'ee\'f2\'ee\'ec\'f3, \'f7\'f2\'ee \'c0\'eb\'eb\'e0\'f5 \'f3\'e2\'e8\'e4\'e5\'eb \'ed\'e0\'f8\'f3 \'f1\'eb\'e0\'e1\'ee\'f1\'f2\'fc \'e8 \'f1\'ec\'e8\'f0\'e5\'ed\'e8\'e5, \'e8 \'f1\'e4\'e5\'eb\'e0\'eb \'e8\'f5 \'e4\'ee\'e7\'e2\'ee\'eb\'e5\'ed\'ed\'fb\'ec\'e8 \'e4\'eb\'ff \'ed\'e0\'f1\ulnone\f1\lang1033\'bb.\par
