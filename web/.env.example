# Copy to .env.local for local development.
# Temporary development gate: one shared login for the whole site.
SITE_LOGIN=admin
SITE_PASSWORD=change-me
# Random string, at least 32 characters: openssl rand -base64 32
SESSION_SECRET=

# Database (optional locally). Supabase: Connect -> Session pooler, port 5432.
DATABASE_URL=
DATABASE_SSL=true
