{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run lint && npm test",
    "build": "next build",
    "start": "node scripts/migrate.mjs && npm run db:import && next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "db:import": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-sources.ts"
  },
  "dependencies": {
    "@fontsource/amiri-quran": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
